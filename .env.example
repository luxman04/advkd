# Copy this file to .env.local for local development, and add the same
# values in your hosting provider's dashboard (Vercel / Netlify / Cloudflare Pages)
# as environment variables for production.

# Get a free API key at https://resend.com (3,000 emails/month free tier).
RESEND_API_KEY=

# Where enquiry emails should be delivered.
# Note: On Resend free tier with onboarding@resend.dev, destination MUST be your Resend account email.
# Once your domain is verified at resend.com/domains, this can be advocatekd24@gmail.com.
CONTACT_TO_EMAIL=advocatekd24@gmail.com

# The "from" address Resend sends as. Until you verify your own domain with
# Resend, you must use onboarding@resend.dev. Once you verify advocatekd.com
# (or your real domain) with Resend, switch this to e.g. contact@advocatekd.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# ── Sanity (blog CMS) ──────────────────────────────────────────────────────
# Create a free project at https://www.sanity.io/manage — these two values
# are shown on the project's overview page.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# A random 32+ character string (e.g. `openssl rand -base64 32`). Set the
# SAME value here and in the Sanity webhook you create (see README) — it's
# how the site verifies a publish notification really came from Sanity.
SANITY_REVALIDATE_SECRET=

# Only needed LOCALLY to run `npm run seed` (imports the original 6 articles
# into Sanity). Create it at manage.sanity.io → API → Tokens, role "Editor".
# Do NOT set this in your hosting provider — the live site never needs it.
SANITY_API_WRITE_TOKEN=
